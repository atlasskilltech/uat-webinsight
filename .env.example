# Copy this file to .env and fill in values as you configure integrations.
# NEVER commit the real .env — it is git-ignored.

# -----------------------------------------------------------------------------
# Database (required). MySQL. DATABASE_URL is a single mysql:// connection
# string — Prisma reads ONLY this variable (DB_HOST/DB_USER/etc. are not used).
# Format:  mysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example (local XAMPP):  mysql://root:@localhost:3306/atlas_dashboard
# Example (remote):       mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# If the password contains @ : / or other special chars, URL-encode them
# (e.g. @ -> %40). Then create the schema:  npx prisma migrate deploy
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/atlas_dashboard"

# -----------------------------------------------------------------------------
# Google OAuth — used by the Search Console/Analytics data integrations AND by
# the dashboard's "Continue with Google" sign-in (Auth.js). Same OAuth client;
# add BOTH redirect URIs to the client's "Authorised redirect URIs":
#   - Data sync (GSC/GA4):   http://localhost:3000/api/integrations/google/callback
#   - Dashboard login:       http://localhost:3000/api/auth/callback/google
# Create an OAuth 2.0 Client (type "Web application") in Google Cloud Console.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# -----------------------------------------------------------------------------
# Dashboard login (Auth.js / Google Sign-In).
# AUTH_SECRET encrypts the session JWT — generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BOOTSTRAP_ADMIN_EMAIL is the designated initial admin (optional; defaults to
# tech@atlasuniversity.edu.in). Only this verified Google account can self-
# bootstrap to admin, and only while no admin exists yet.
# -----------------------------------------------------------------------------
AUTH_SECRET=""
BOOTSTRAP_ADMIN_EMAIL="tech@atlasuniversity.edu.in"

# Optional: use a DEDICATED Google OAuth client for dashboard login, separate
# from the GSC/GA4 data client above. If set, these take priority over
# GOOGLE_CLIENT_ID/SECRET for sign-in. The login client must have this redirect
# URI registered:  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# Google Search Console — the verified property to pull Search performance from.
# Domain property:  sc-domain:atlasuniversity.edu.in
# URL-prefix property:  https://atlasuniversity.edu.in/
# Used as a FALLBACK when no property id is saved in Settings → Website Property
# (a value saved there takes priority).
# -----------------------------------------------------------------------------
GSC_PROPERTY=""

# -----------------------------------------------------------------------------
# Google Analytics 4 — the numeric property id (Admin > Property Settings).
# Used as a FALLBACK when no GA4 property id is saved in Settings (DB wins).
# -----------------------------------------------------------------------------
GA4_PROPERTY_ID=""

# -----------------------------------------------------------------------------
# Automatic daily sync (Search Console + GA4).
# CRON_SECRET protects the /api/cron/sync endpoint that the scheduler calls.
#   Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_URL is the base URL the sync script posts to (the running Next.js server),
#   and is also used to build invite / password-reset links in Admin → Users.
# SYNC_WINDOW_DAYS is how many trailing days each scheduled run re-pulls
#   (optional; default 30). The most recent 1-2 days may be incomplete until
#   Google Search Console finalises them, and self-correct on the next run.
# -----------------------------------------------------------------------------
CRON_SECRET=""
APP_URL="http://localhost:3000"
SYNC_WINDOW_DAYS="30"

# -----------------------------------------------------------------------------
# PageSpeed Insights (optional). Without a key the Page Inspector still works
# but is rate-limited by Google. Create a key in Google Cloud Console.
# -----------------------------------------------------------------------------
PAGESPEED_API_KEY=""
