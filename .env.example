# Copy this file to .env and fill in values as you configure integrations.
# NEVER commit the real .env — it is git-ignored.

# -----------------------------------------------------------------------------
# Database (required). MySQL. Configure it EITHER way:
#   (A) a single connection string:
#         DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME"
#   (B) the individual parts below — DATABASE_URL is composed from them when it
#       is not set. An explicit DATABASE_URL always takes priority.
#         DB_HOST, DB_PORT (optional, default 3306), DB_USER, DB_PASSWORD, DB_NAME
# In mode (B) special characters in the password are URL-encoded automatically;
# in mode (A) you must encode them yourself (e.g. @ -> %40).
# Create the schema with:  npm run db:init
# -----------------------------------------------------------------------------
# Option A — single URL:
# DATABASE_URL="mysql://user:password@localhost:3306/atlas_dashboard"

# Option B — individual parts:
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="atlas_dashboard"

# -----------------------------------------------------------------------------
# Google OAuth — used by the Search Console/Analytics data integrations AND by
# the dashboard's "Continue with Google" sign-in (Auth.js). Same OAuth client;
# add BOTH redirect URIs to the client's "Authorised redirect URIs":
#   - Data sync (GSC/GA4):   http://localhost:3000/api/integrations/google/callback
#   - Dashboard login:       http://localhost:3000/api/auth/callback/google
# Create an OAuth 2.0 Client (type "Web application") in Google Cloud Console.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# -----------------------------------------------------------------------------
# Dashboard login (Auth.js / Google Sign-In).
# AUTH_SECRET encrypts the session JWT — generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BOOTSTRAP_ADMIN_EMAIL is the designated initial admin (optional; defaults to
# tech@atlasuniversity.edu.in). Only this verified Google account can self-
# bootstrap to admin, and only while no admin exists yet.
# -----------------------------------------------------------------------------
AUTH_SECRET=""
BOOTSTRAP_ADMIN_EMAIL="tech@atlasuniversity.edu.in"

# Optional: use a DEDICATED Google OAuth client for dashboard login, separate
# from the GSC/GA4 data client above. If set, these take priority over
# GOOGLE_CLIENT_ID/SECRET for sign-in. The login client must have this redirect
# URI registered:  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# Google Search Console — the verified property to pull Search performance from.
# Domain property:  sc-domain:atlasuniversity.edu.in
# URL-prefix property:  https://atlasuniversity.edu.in/
# Used as a FALLBACK when no property id is saved in Settings → Website Property
# (a value saved there takes priority).
# -----------------------------------------------------------------------------
GSC_PROPERTY=""

# -----------------------------------------------------------------------------
# Google Analytics 4 — the numeric property id (Admin > Property Settings).
# Used as a FALLBACK when no GA4 property id is saved in Settings (DB wins).
# -----------------------------------------------------------------------------
GA4_PROPERTY_ID=""

# -----------------------------------------------------------------------------
# Automatic daily sync (Search Console + GA4).
# CRON_SECRET protects the /api/cron/sync endpoint that the scheduler calls.
#   Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_URL is the app's PUBLIC base URL (scheme + host). The sync script posts to
#   it, it builds invite / password-reset links, AND it is the URL every OAuth
#   flow (Google & Gmail) redirects back to. Behind a reverse proxy it MUST be
#   set to the public URL, or post-OAuth redirects would go to the internal
#   origin (e.g. http://localhost:9091 → ERR_CONNECTION_REFUSED).
#     local:      http://localhost:3000
#     UAT:        https://webinsight.atlasskilltech.app   (the UAT host)
#     production: https://<your-production-host>
#   (AUTH_URL / NEXTAUTH_URL are also honoured; forwarded proxy headers are the
#    fallback when none is set, so a deployed user is never sent to localhost.)
# SYNC_WINDOW_DAYS is how many trailing days each scheduled run re-pulls
#   (optional; default 30). The most recent 1-2 days may be incomplete until
#   Google Search Console finalises them, and self-correct on the next run.
# -----------------------------------------------------------------------------
CRON_SECRET=""
APP_URL="http://localhost:3000"
SYNC_WINDOW_DAYS="30"

# -----------------------------------------------------------------------------
# PageSpeed Insights (optional). Without a key the Page Inspector still works
# but is rate-limited by Google. Create a key in Google Cloud Console.
# -----------------------------------------------------------------------------
PAGESPEED_API_KEY=""

# -----------------------------------------------------------------------------
# Downtime email alerts (optional). When a monitored domain stays DOWN past the
# threshold (Settings -> Downtime alerts, default 120s), the recipients listed
# in Settings are emailed. Sending needs a transactional-email provider here;
# if these are unset, alerting safely does nothing (the monitor keeps running).
#   EMAIL_PROVIDER   "resend" (default) or "sendgrid"
#   EMAIL_API_KEY    the provider API key
#   EMAIL_FROM       a VERIFIED sender address in that provider (required),
#                    e.g. alerts@atlasuniversity.edu.in
#   EMAIL_FROM_NAME  optional display name (default "Atlas Web Insight")
# Recipients are NOT set here — they live in the dashboard Settings page.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Atlas Web Insight"

# -----------------------------------------------------------------------------
# Domain monitor cadence (optional). How often the server health-checks every
# monitored domain, in seconds (default 60, minimum 20). A lower value detects
# outages sooner for the downtime email alert above, at the cost of more checks.
# -----------------------------------------------------------------------------
MONITOR_INTERVAL_SECONDS="60"

# =============================================================================
# ATLAS INVOICE AGENT (new finance module). All variables below are OPTIONAL for
# the main app; the Invoice Agent activates features only as each is configured.
# NEVER commit real secrets.
# =============================================================================

# --- Invoice database. Connection parts default to the main DB_* values (same
# MySQL account/server). The Invoice Agent uses only its own snake_case tables
# (no name overlap with the PascalCase Web Insight tables) and never modifies the
# existing Web Insight tables. Set ATLAS_INVOICE_DB_NAME to either a dedicated
# schema (`atlas_invoice`) OR the existing main database (`atlas_dashboard`) to
# share one database. Create/migrate the Invoice Agent tables with:
#   npm run invoice:db:init
ATLAS_INVOICE_DB_HOST=""          # defaults to DB_HOST
ATLAS_INVOICE_DB_PORT=""          # defaults to DB_PORT / 3306
ATLAS_INVOICE_DB_USER=""          # defaults to DB_USER
ATLAS_INVOICE_DB_PASSWORD=""      # defaults to DB_PASSWORD
ATLAS_INVOICE_DB_NAME="atlas_invoice"   # or "atlas_dashboard" to share the main DB

# --- Encryption (AES-256-GCM) for OAuth tokens & bank details. 32-byte key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVOICE_ENCRYPTION_KEY=""

# --- AI extraction / assistant (provider-independent). Not active until set.
# Both the invoice extractor and the AI Workspace use these three vars (one
# model for both). Supported providers: "anthropic" (Messages API) or "openai"
# (Chat Completions). AI_MODEL must be a model id for the chosen provider.
#   anthropic -> AI_MODEL e.g. claude-sonnet-5-5 ; AI_API_KEY = Anthropic key
#   openai    -> AI_MODEL e.g. gpt-4.1          ; AI_API_KEY = OpenAI key (sk-...)
# Confirm the exact current model id on your provider's model/pricing page.
AI_PROVIDER=""                    # anthropic | openai
AI_MODEL=""                       # a model id for AI_PROVIDER (required)
AI_API_KEY=""                     # the API key for AI_PROVIDER (never commit it)

# --- OCR (provider-independent). Not active until the SELECTED provider is
# fully configured. OCR only reads SCANNED PDFs/images into text for the AI
# extractor; it never affects forwarding or GST/total calculations.
#   OCR_PROVIDER=tesseract   -> local; requires `npm install tesseract.js`
#   OCR_PROVIDER=documentai  -> Google Cloud Document AI Invoice Parser (below)
OCR_PROVIDER=""                   # tesseract | documentai  (blank = OCR off)
OCR_API_KEY=""                    # reserved for future key-based providers; NOT used by documentai

# --- Google Cloud Document AI (when OCR_PROVIDER=documentai). Text-only: returns
# Document AI's recognized text to the existing AI extraction pipeline.
# Auth uses a Google Cloud SERVICE ACCOUNT (NOT an API key). Grant the service
# account the "Document AI API User" role; enable the Document AI API; create an
# Invoice Parser processor and copy its ID. All four are required to activate it.
DOCAI_PROJECT_ID=""               # GCP project id (e.g. atlas-invoice-prod)
DOCAI_LOCATION=""                 # processor region: us | eu (must match the processor)
DOCAI_PROCESSOR_ID=""             # the Invoice Parser processor id
# Path to the service-account JSON key on the server (the raw JSON is also
# accepted). Host must allow egress to {LOCATION}-documentai.googleapis.com and
# oauth2.googleapis.com. NEVER commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Gmail (SEPARATE OAuth client from the GSC/GA4 integration). Gmail scopes
# require Google verification.
# GMAIL_REDIRECT_URI is the callback Google returns to. It MUST be listed EXACTLY
# as an "Authorized redirect URI" on the OAuth client in Google Cloud Console
# (APIs & Services → Credentials), per environment:
#     local:      http://localhost:3000/api/invoices/gmail/callback
#     UAT:        https://webinsight.atlasskilltech.app/api/invoices/gmail/callback
#     production: https://<your-production-host>/api/invoices/gmail/callback
# If left blank, it is derived from APP_URL as <APP_URL>/api/invoices/gmail/callback
# (still must be registered in the Console). Never point it at a proxy/internal host.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/invoices/gmail/callback"
# Gmail push notifications (near real-time) via Google Cloud Pub/Sub. When set,
# a Gmail "watch" is registered per connected account (on connect + renewed by
# the worker before the ~7-day expiry) and Gmail POSTs history notifications to
# the push endpoint, which enqueues a sync drained within ~1 cycle. When UNSET,
# the system falls back to the <=2-minute polling reconciliation below.
# Google Cloud setup (one-time, per project):
#   1. Create a Pub/Sub topic, e.g. projects/<PROJECT>/topics/gmail-invoice.
#   2. Grant the Gmail publisher service account Publisher on that topic:
#        gcloud pubsub topics add-iam-policy-binding gmail-invoice \
#          --member=serviceAccount:gmail-api-push@system.gserviceaccount.com \
#          --role=roles/pubsub.publisher
#   3. Create a PUSH subscription whose endpoint is the public push URL WITH the
#      secret token, e.g. https://<APP_URL>/api/invoices/gmail/push?token=<secret>
#   4. The connected Gmail account's OAuth must include the gmail.readonly scope
#      (already requested) for watch() to work.
GMAIL_PUBSUB_TOPIC=""
# Shared secret checked on the push endpoint (?token=...). Falls back to
# INVOICE_CRON_SECRET when blank. Set it to the token used in the subscription.
GMAIL_PUBSUB_VERIFICATION_AUDIENCE=""

# --- Document storage. "local" (default, private dir) or "s3".
INVOICE_STORAGE_PROVIDER="local"
INVOICE_STORAGE_DIR=""            # local only; defaults to ./.invoice-storage
INVOICE_MAX_UPLOAD_MB="20"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                    # optional (S3-compatible / MinIO)

# --- Background worker (DB-backed queue; no Redis required)
# The worker runs IN-PROCESS inside the Next.js server (started from
# src/instrumentation.ts) — no separate pm2 app. Set INVOICE_WORKER_DISABLED=1 to
# turn it off (e.g. to drive the /api/invoices/cron/* endpoints from an external
# scheduler or scripts/invoice-worker.mjs instead). INVOICE_WORKER_STALE_MINUTES
# is how long a job may sit in 'running' before it is treated as interrupted and
# recovered (default 15).
INVOICE_WORKER_DISABLED=""
INVOICE_WORKER_STALE_MINUTES="15"
INVOICE_WORKER_CONCURRENCY="2"
INVOICE_JOB_RETRY_LIMIT="5"

# --- Invoice Agent automation (worker + cron endpoints)
# Bearer token protecting /api/invoices/cron/* (falls back to CRON_SECRET if unset).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVOICE_CRON_SECRET=""
# Polling FALLBACK cadence (minutes): how stale a connected Gmail account may be
# before the worker re-syncs it when Gmail push isn't delivering. Default 2 and
# CAPPED at 2 (the maximum fallback latency). Gmail push is the primary path.
GMAIL_SYNC_INTERVAL_MIN="2"
# Optional Gmail search override and look-back window for sync. The default
# query is INBOX-ONLY (`in:inbox -in:sent -in:chats has:attachment newer_than:<days>d`)
# so the agent never ingests its own Sent/forwarded mail (which would loop).
# Only override this if you know you need a different scope.
GMAIL_QUERY=""
GMAIL_SYNC_DAYS="90"
# Worker loop cadences. The in-process worker's sync tick is CAPPED at 2 minutes
# (the polling fallback); Gmail push handles the real-time case.
INVOICE_WORKER_DRAIN_SECONDS="10"
INVOICE_WORKER_SYNC_MINUTES="2"
INVOICE_WORKER_PERIODIC_MINUTES="60"
